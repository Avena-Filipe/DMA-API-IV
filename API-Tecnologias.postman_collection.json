{
  "info": {
    "name": "API de Tecnologias - CRUD JWT",
    "description": "Teste em ordem: login, listar, cadastrar, buscar, editar, excluir. Guarda token e id automaticamente.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3003"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "id",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 - Login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "login"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"usuario\": \"admin\",\n  \"senha\": \"ALTERE_PARA_A_SENHA_DO_SEU_ENV\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if(pm.response.code===200)pm.collectionVariables.set('token',pm.response.json().token);"
            ]
          }
        }
      ]
    },
    {
      "name": "02 - Listar tecnologias",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/tecnologias",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "tecnologias"
          ]
        }
      }
    },
    {
      "name": "03 - Cadastrar React",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/tecnologias",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "tecnologias"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nome\": \"React\",\n  \"base\": \"JavaScript\",\n  \"curvaAprendizado\": 6\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if(pm.response.code===201)pm.collectionVariables.set('id',pm.response.json()._id);"
            ]
          }
        }
      ]
    },
    {
      "name": "04 - Consultar tecnologia por id",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/tecnologias/{{id}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "tecnologias",
            "{{id}}"
          ]
        }
      }
    },
    {
      "name": "05 - Atualizar React",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/tecnologias/{{id}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "tecnologias",
            "{{id}}"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nome\": \"React\",\n  \"base\": \"JavaScript\",\n  \"curvaAprendizado\": 8\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "name": "06 - Excluir React",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/tecnologias/{{id}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "tecnologias",
            "{{id}}"
          ]
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "name": "07 - POST sem token deve retornar 401",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/tecnologias",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "tecnologias"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nome\": \"Vue\",\n  \"base\": \"JavaScript\",\n  \"curvaAprendizado\": 6\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "08 - POST com dados inválidos deve retornar 400",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/tecnologias",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "tecnologias"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nome\": \"Angular\",\n  \"base\": \"JavaScript\",\n  \"curvaAprendizado\": 0\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        }
      }
    }
  ]
}
